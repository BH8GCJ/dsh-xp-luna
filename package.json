{
  "name": "@local/dsh-xp-luna",
  "version": "1.3.5",
  "private": true,
  "type": "module",
  "description": "Windows XP Luna skin for the DeepSeek Harness Web UI, with a full Settings page for wallpaper and window material (wallpaper stored on the Host, not bundled).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BH8GCJ/dsh-xp-luna.git"
  },
  "homepage": "https://github.com/BH8GCJ/dsh-xp-luna#readme",
  "bugs": {
    "url": "https://github.com/BH8GCJ/dsh-xp-luna/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "skin",
    "windows-xp",
    "luna",
    "wallpaper"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src/client.js",
    "scripts/build.mjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  }
}
